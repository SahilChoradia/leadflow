# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# MongoDB — use Atlas URI in production
MONGO_URI=mongodb://localhost:27017/leadflow

# Redis — use Upstash URL in production
REDIS_URL=redis://localhost:6379

# JWT & Security
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d
WEBHOOK_SECRET=optional_hmac_secret_for_webhook_verification
CLIENT_URL=http://localhost:5173

# S3-compatible object storage (AWS S3 free tier or Cloudflare R2)
S3_ENDPOINT=https://s3.amazonaws.com      # For R2: https://<account_id>.r2.cloudflarestorage.com
S3_REGION=eu-central-1
S3_BUCKET=leadflow-documents
S3_ACCESS_KEY_ID=your_access_key_here
S3_SECRET_ACCESS_KEY=your_secret_key_here

# Email (optional — set SMTP_ENABLED=false to mock/log only)
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=smtp_password

# Platform bootstrap (admin seed)
PLATFORM_ADMIN_EMAIL=admin@leadflow.app
PLATFORM_ADMIN_PASSWORD=ChangeMe123!

# ─── Client (VITE_ prefix exposes to browser) ───────────────────────────────
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# ─── Worker ─────────────────────────────────────────────────────────────────
# (shares MONGO_URI, REDIS_URL, S3_* from server section above)
WORKER_CONCURRENCY=5
